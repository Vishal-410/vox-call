{
  "name": "vox-call",
  "version": "1.0.0",
  "description": "Ultra-lightweight WebRTC Audio & Video Calling SDK for the browser",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "server": "node server/signaling-server.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "webrtc",
    "video-calling",
    "audio-calling",
    "voip",
    "screensharing",
    "typescript",
    "peer-to-peer"
  ],
  "author": "Vishal <https://github.com/Vishal-410>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vishal-410/vox-call.git"
  },
  "bugs": {
    "url": "https://github.com/Vishal-410/vox-call/issues"
  },
  "homepage": "https://github.com/Vishal-410/vox-call#readme",
  "license": "MIT",
  "devDependencies": {
    "tsup": "^8.0.2",
    "typescript": "^5.3.3",
    "ws": "^8.18.0"
  }
}
